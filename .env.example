# Copy these into Vercel: Project -> Settings -> Environment Variables.
# Never commit the real values.

# Neon -> your project -> Connection string (pooled)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Resend -> API Keys -> Create
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# The from-address. The domain must be verified in Resend first.
MAIL_FROM="Saad <hello@metaljewel.com>"

# Where new-contact notifications land.
MAIL_TO="saad.shahzad1990@gmail.com"

# Public site URL, used in the confirmation email button.
SITE_URL="https://metaljewel.com"

# Make one up: any long random string. Guards /api/export.
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
ADMIN_TOKEN="change-me-to-something-long-and-random"

# Make one up too. Salts the IP hash so stored hashes aren't reversible.
IP_SALT="another-long-random-string"
